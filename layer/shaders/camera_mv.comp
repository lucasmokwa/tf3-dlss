#version 450
// Camera motion vectors for DLSS, reconstructed from depth.
//
// For each render-resolution pixel: rebuild its world position from depth and this frame's
// inverse view-projection, project it with last frame's view-projection, and store
// (previous pixel position - current pixel position) in pixels, as DLSS expects.
//
// Conventions (from the game's shaders and our matrix checks):
//   * GL-style projection; stored depth d maps to NDC z = 2d - 1 (see calcEyeZ in ssr_apply.fs).
//   * curInvViewProj is the jittered inverse (the depth buffer was rendered with jitter);
//     prevViewProj is last frame's unjittered matrix, so the result excludes jitter.
//   * Pixel rows run top-down: row 0 is NDC y = +1 (verified against recorded frames - warping
//     colour with these vectors only lines up with this orientation). Motion and jitter are in
//     that same top-down pixel space, which is what DLSS expects.
// Moving objects are added afterwards by the object pass (object_mv.vert/.frag).
// Also copies depth into an R32F image (binding 3): FSR 3.1 reads that instead of the game's
// depth/stencil buffer, whose format its runtime can't always view directly.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
// Packed half2 per pixel (row-major, tightly packed); copied into an R16G16_SFLOAT image after.
// (A buffer avoids needing the shaderStorageImageExtendedFormats device feature.)
layout(set = 0, binding = 1, std430) writeonly buffer MvOut { uint mvOut[]; };
layout(set = 0, binding = 2, std140) uniform Matrices {
    mat4 curInvViewProj;   // this frame: projViewInverse
    mat4 prevViewProj;     // last frame: projView
    vec4 sizeAndScale;     // xy = render size in pixels, z = 1 to enable, 0 to write zeros
    vec4 jitterPx;         // xy = this frame's jitter in pixels (depth was rendered with it)
} u;
layout(set = 0, binding = 3, r32f) writeonly uniform image2D depthOut;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(u.sizeAndScale.xy);
    if (p.x >= size.x || p.y >= size.y) return;
    float d = texelFetch(depthTex, p, 0).r;
    imageStore(depthOut, p, vec4(d));
    if (u.sizeAndScale.z == 0.0) {
        mvOut[p.y * size.x + p.x] = 0u;
        return;
    }

    vec2 pix = vec2(p) + 0.5;
    vec4 ndc = vec4(pix.x / float(size.x) * 2.0 - 1.0, 1.0 - pix.y / float(size.y) * 2.0, d * 2.0 - 1.0, 1.0);

    vec4 world = u.curInvViewProj * ndc;
    world /= world.w;

    vec4 prevClip = u.prevViewProj * world;
    vec2 mv = vec2(0.0);
    if (prevClip.w > 1e-6) {
        vec2 prevNdc = prevClip.xy / prevClip.w;
        vec2 prevPix = vec2((prevNdc.x * 0.5 + 0.5) * float(size.x), (0.5 - prevNdc.y * 0.5) * float(size.y));
        // DLSS wants unjittered motion: this pixel's unjittered position is pix - jitter.
        mv = prevPix - (pix - u.jitterPx.xy);
    }
    mvOut[p.y * size.x + p.x] = packHalf2x16(mv);
}
